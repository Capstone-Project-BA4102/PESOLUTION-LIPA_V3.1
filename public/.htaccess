# PESOLUTION LIPA V3 — React SPA routing on Hostinger (Apache/LiteSpeed)
# Direct URL loads (e.g. /admin/matching/.../referral) must serve index.html
# so React Router can handle the path client-side.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
