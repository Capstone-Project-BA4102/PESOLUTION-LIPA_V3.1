VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Public address of the portal. Printed documents (the account receipt) show this instead
# of the origin the admin happens to be browsing from. Leave blank only for local dev.
VITE_APP_PUBLIC_URL=https://pesolution-lipa-v3.pages.dev
# Set this when the Express backend is hosted separately (for example Render) so
# the site calls https://SERVICE.onrender.com/api instead of its own origin.
# Leave blank for the single-server build where Express serves ./dist.
VITE_BACKEND_URL=
# Backend local NLP settings (never prefix with VITE_).
SKILL_NLP_URL=http://127.0.0.1:8002/match
SKILL_NLP_THRESHOLD=0.85
SKILL_NLP_TIMEOUT_MS=30000
# Express reads this root .env locally. Use this same template for backend hosting.
# Server keys below must NEVER use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RESUME_MODEL=
GEMINI_SKILL_MODEL=
HOST=127.0.0.1
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_PUBLIC_URL=https://pesolution-lipa-v3.pages.dev
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PESOLUTION / PESO Lipa City

# Optional deployment/runtime settings retained from the former backend template.
DEPLOYMENT_HEALTH_URL=
DEPLOYMENT_VERSION=local
PYTHON_COMMAND=python
