# PESOLUTION V3.1 environment configuration
# Copy .env.example to .env, then fill in private credentials locally.
# Never commit .env. Hosting variables are configured in the hosting dashboard.
# Restart the backend after edits; rebuild the frontend after VITE_ changes.

# -----------------------------------------------------------------------------
# Frontend — public browser configuration
# -----------------------------------------------------------------------------
# Only publishable values belong here. Never put secret keys in VITE_ variables.
# Use the same Supabase project as the backend.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_APP_PUBLIC_URL=http://localhost:3000
VITE_BACKEND_URL=

# -----------------------------------------------------------------------------
# Backend — Supabase
# -----------------------------------------------------------------------------
# Required: project URL and service-role key. Keep the service-role key private.
# SUPABASE_PUBLISHABLE_KEY is optional; blank uses the frontend publishable key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Backend — Gemini resume extraction and skill processing
# -----------------------------------------------------------------------------
# Set GEMINI_API_KEY to enable Gemini features.
# Blank resume/skill overrides use GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RESUME_MODEL=
GEMINI_SKILL_MODEL=

# -----------------------------------------------------------------------------
# Backend — local NLP matching
# -----------------------------------------------------------------------------
# Start the local NLP service separately. Timeout is in milliseconds.
SKILL_NLP_URL=http://127.0.0.1:8002/match
SKILL_NLP_THRESHOLD=0.85
SKILL_NLP_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Backend — email delivery (Brevo)
# -----------------------------------------------------------------------------
# Configure the API key and a verified sender email to send account emails.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PESOLUTION / PESO Lipa City

# -----------------------------------------------------------------------------
# Backend — account receipt security
# -----------------------------------------------------------------------------
# Use a long, randomly generated secret for a new installation. Keep it private.
# Blank falls back to SUPABASE_SERVICE_ROLE_KEY. Changing the effective key
# makes previously sealed receipt passwords unreadable; preserve existing keys.
RECEIPT_SECRET_KEY=

# -----------------------------------------------------------------------------
# Portal URLs and server
# -----------------------------------------------------------------------------
# APP_PUBLIC_URL and VITE_APP_PUBLIC_URL should point to the same public portal.
# VITE_BACKEND_URL: blank for Vite proxy/single-server hosting; set the backend
# origin (without /api) when frontend and backend are hosted separately.
# For hosting, use HOST=0.0.0.0 and the port supplied by your hosting provider.
# ALLOWED_ORIGINS: comma-separated frontend origins; no paths or trailing slashes.
APP_PUBLIC_URL=http://localhost:3000
HOST=127.0.0.1
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Optional runtime and deployment
# -----------------------------------------------------------------------------
# Leave health URL blank unless running the deployment verification tool.
DEPLOYMENT_HEALTH_URL=
DEPLOYMENT_VERSION=local
PYTHON_COMMAND=python
