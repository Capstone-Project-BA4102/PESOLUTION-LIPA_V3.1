SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional per-task models. Leave blank to fall back to GEMINI_MODEL.
# GEMINI_RESUME_MODEL handles resume OCR, GEMINI_SKILL_MODEL handles the matching analysis.
GEMINI_RESUME_MODEL=
GEMINI_SKILL_MODEL=
PORT=5000
HOST=127.0.0.1
# Comma-separated list of frontend origins allowed to call this API. In production
# replace the localhost entries with the deployed site origin, for example
# ALLOWED_ORIGINS=https://pesolution-lipa-v3.pages.dev. Never use a wildcard.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEPLOYMENT_HEALTH_URL=
DEPLOYMENT_VERSION=local
PYTHON_COMMAND=python
# Optional absolute directory; defaults to backend/model-artifacts.
SENTIMENT_ARTIFACT_DIR=
# Where the XLM-R sentiment service answers. Keep the default: the service runs on this machine
# (npm run sentiment:start). The hosted backend deliberately leaves this unset-reachable, so live
# feedback is stored as Waiting and is analyzed by running the portal here against the same
# Supabase project. sentiment-space/ documents the paid Hugging Face Space alternative.
# Sentiment is a nice-to-have: if this endpoint does not answer, nothing is lost.
SENTIMENT_INFERENCE_URL=http://127.0.0.1:8001/predict
SENTIMENT_INFERENCE_KEY=
SENTIMENT_TIMEOUT_MS=30000
SENTIMENT_MODEL_DIR=
SENTIMENT_DEVICE=cpu
SENTIMENT_MAX_LENGTH=256
SENTIMENT_HOST=127.0.0.1
SENTIMENT_PORT=8001
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PESOLUTION / PESO Lipa City
# Where applicants are sent: the welcome email button and the printed receipt both use this.
# Local: http://localhost:3000  Production (Cloudflare Pages): https://pesolution-lipa-v3.pages.dev
APP_PUBLIC_URL=https://pesolution-lipa-v3.pages.dev
# The browser-grade publishable key, used only so this server can call Supabase Authentication
# (GoTrue) to verify an applicant's current password before changing it. The service role key
# cannot do that. Local runs fall back to VITE_SUPABASE_PUBLISHABLE_KEY in the root .env, so this
# is only needed where the backend has its own environment, e.g. Render.
SUPABASE_PUBLISHABLE_KEY=
